linters: linters_with_defaults(
    return_linter = NULL,
    pipe_consistency_linter = NULL
  )
exclusions: list(
    "data-raw",
    "R/geom_event_point.R" = list( # param names to match ggplot2
      object_name_linter = Inf
    ),
    "R/geom_track_path.R" = list( # param names to match ggplot2
      object_name_linter = Inf
    ),
    "R/geom_event_path.R" = list( # param names to match ggplot2
      object_name_linter = Inf
    ),
    "R/PackedSpatRaster_list.R" = list( # class name derived from terra
      object_name_linter = Inf
    )
  )
encoding: "UTF-8"
